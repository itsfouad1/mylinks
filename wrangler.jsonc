{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fouad-links",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-07-30",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fouad-links-db",
			"database_id": "363a6e3b-7cf2-4b38-9c87-c335898ce150",
			"migrations_dir": "migrations",
		},
		{
			"binding": "fouad_links_db",
			"database_name": "fouad-links-db",
			"database_id": "363a6e3b-7cf2-4b38-9c87-c335898ce150",
			"remote": true
		},
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "fouad-links-files"
		},
		{
			"bucket_name": "fouad-links-files",
			"binding": "fouad_links_files",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"15 3 * * *"
		]
	},
	"observability": {
		"enabled": false
	},
}
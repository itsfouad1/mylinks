{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fouad-links",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fouad-links-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{"binding": "FILES", "bucket_name": "fouad-links-files"}],
  "triggers": {"crons": ["15 3 * * *"]},
  "observability": {"enabled": false}
}
